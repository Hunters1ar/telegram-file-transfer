[Unit]
Description=TelegramFileTransfer FastAPI
After=network.target

[Service]
User=root
WorkingDirectory=/root/telegram-file-transfer
EnvironmentFile=/root/telegram-file-transfer/.env
ExecStart=/root/telegram-file-transfer/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

# Rename and copy this file to /etc/systemd/system/telegramfiletransfer.service
# then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable telegramfiletransfer
#   sudo systemctl restart telegramfiletransfer
#   sudo journalctl -u telegramfiletransfer -f
